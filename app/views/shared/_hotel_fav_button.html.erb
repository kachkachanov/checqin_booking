<button type="button"
        id="hf-<%= hotel.id %>"
        class="fav-heart-btn"
        onclick="toggleFav(<%= hotel.id %>)"
        title="<%= hotel_favorited?(hotel) ? 'Убрать из избранного' : 'В избранное' %>"
        style="position:absolute;top:12px;right:12px;width:34px;height:34px;border-radius:50%;border:none;background:rgba(5,15,12,.75);backdrop-filter:blur(8px);cursor:pointer;transition:all .2s;z-index:2">
  <svg width="18" height="18" viewBox="0 0 24 24"
       fill="<%= hotel_favorited?(hotel) ? '#f87171' : 'none' %>"
       stroke="<%= hotel_favorited?(hotel) ? '#f87171' : '#9bbdb5' %>"
       stroke-width="2" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
  </svg>
</button>
