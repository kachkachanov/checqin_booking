<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Checqin — Мои бронирования</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
<script>tailwind.config={theme:{extend:{colors:{tl:'#1db896',bg:'#050f0c',bg3:'#0d1c18',tx:'#e8f5f1',tx2:'#9bbdb5',tx3:'#5a8078'},fontFamily:{serif:['"DM Serif Display"','serif'],sans:['"Plus Jakarta Sans"','sans-serif']}}}}</script>
<style>body{font-family:'Plus Jakarta Sans',sans-serif;margin:0}.glass-hdr{background:rgba(5,15,12,.82);backdrop-filter:blur(20px);border-bottom:1px solid rgba(29,184,150,.15)}.glass{background:rgba(13,28,24,.88);border:1px solid rgba(29,184,150,.18);border-radius:20px}</style>
</head>
<body class="bg-bg min-h-screen text-tx">
<%= render 'shared/flash_notice' %>
<div class="relative z-10 max-w-3xl mx-auto px-4 py-8">
  <div class="flex items-center gap-3 mb-8">
    <a href="/" class="w-9 h-9 rounded-xl border border-white/10 flex items-center justify-center text-tx2 hover:text-tl">←</a>
    <h1 class="font-serif text-2xl">Мои бронирования</h1>
  </div>
  <% if @bookings.any? %>
    <div class="space-y-4">
      <% @bookings.each do |booking| %>
        <a href="<%= booking_path(booking) %>" class="glass block p-5 hover:border-tl/40 transition-all no-underline">
          <div class="flex justify-between gap-4">
            <div>
              <div class="font-bold text-tx"><%= booking.hotel.name %></div>
              <div class="text-tx3 text-sm mt-1"><%= booking.hotel.city %></div>
              <div class="text-tx2 text-sm mt-2"><%= booking.room_name %> · <%= booking.guests %> гост.</div>
              <div class="text-tx2 text-xs mt-1"><%= l(booking.check_in, format: '%d %b %Y') %> — <%= l(booking.check_out, format: '%d %b %Y') %> · <%= booking.nights %> ноч.</div>
            </div>
            <div class="text-right flex-shrink-0">
              <div class="font-serif text-tx text-xl"><%= format_hotel_price(booking.total_price) %></div>
              <span class="inline-block mt-2 text-[10px] font-bold uppercase tracking-wide text-tl bg-tl/10 px-2 py-1 rounded-md"><%= booking.status == 'confirmed' ? 'Подтверждено' : booking.status %></span>
            </div>
          </div>
        </a>
      <% end %>
    </div>
  <% else %>
    <div class="glass p-10 text-center">
      <div class="text-4xl mb-4">📅</div>
      <p class="text-tx2 mb-4">У вас пока нет бронирований</p>
      <a href="/" class="inline-block px-6 py-3 rounded-xl text-bg font-bold text-sm" style="background:linear-gradient(135deg,#1db896,#15a07f)">Найти отель</a>
    </div>
  <% end %>
</div>
</body>
</html>
